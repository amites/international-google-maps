{
  "manifest_version": 3,
  "name": "International Names for Google Maps",
  "description": "Restore Lake Ontario and Gulf of Mexico in Google Maps.",
  "version": "1.0.1",
  "permissions": ["storage"],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "International Names for Google Maps"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps*", "https://maps.google.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
